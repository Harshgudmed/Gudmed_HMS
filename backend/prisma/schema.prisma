// Hospital Management System - Complete Database Schema
// PostgreSQL with comprehensive hospital management features

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE TABLES
// ============================================

/// Hospital/Organization
model Organization {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  logoUrl        String?
  primaryColor   String  @default("#2563eb")
  secondaryColor String  @default("#7c3aed")

  // Contact Info
  email   String?
  phone   String?
  address String?
  city    String?
  region  String?
  country String  @default("Ethiopia")

  // Settings (JSON string)
  settings String @default("{\"currency\":\"INR\",\"language\":\"en\",\"timezone\":\"Asia/Kolkata\",\"workingHours\":{\"start\":\"08:00\",\"end\":\"17:00\"},\"appointmentDuration\":30}")

  // Subscription
  subscriptionTier      String    @default("basic")
  subscriptionStatus    String    @default("trial")
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?

  // Modules enabled (JSON string)
  modulesEnabled String @default("{\"pharmacy\":true,\"laboratory\":true,\"radiology\":true,\"inpatient\":false,\"inventory\":true,\"accounting\":false}")

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  users               User[]
  patients            Patient[]
  appointments        Appointment[]
  consultations       Consultation[]
  preTriages          PreTriage[]
  queues              QueueManagement[]
  triageAssessments   TriageAssessment[]
  pharmacyDrugs       PharmacyDrug[]
  prescriptions       Prescription[]
  pharmacySales       PharmacySale[]
  labTests            LabTest[]
  labOrders           LabOrder[]
  radiologyExams      RadiologyExam[]
  radiologyOrders     RadiologyOrder[]
  billingServices     BillingService[]
  invoices            Invoice[]
  payments            Payment[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  userInvitations     UserInvitation[]
  departments         Department[]
  wards               Ward[]
  beds                Bed[]
  admissions          Admission[]
  deathCertificates        DeathCertificate[]
  doctorCommissionConfigs  DoctorCommissionConfig[]
  doctorCommissions        DoctorCommission[]
  pharmacyPurchaseOrders   PharmacyPurchaseOrder[]
  machineIntegrations MachineIntegration[]
  machineResultsQueue MachineResultsQueue[]

  // eAPTS Relations
  eaptsConfig             EaptsConfig?
  eaptsMedicationMappings EaptsMedicationMapping[]
  eaptsTransactions       EaptsTransaction[]
}

/// User (Staff)
model User {
  id             String  @id @default(cuid())
  organizationId String
  email          String  @unique
  passwordHash   String?

  // Personal Info
  fullName    String
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?

  // Professional Info
  employeeId     String?
  role           String // super_admin, admin, doctor, nurse, receptionist, pharmacist, lab_tech, lab_supervisor, radiologist, radiology_tech, billing_clerk, inventory_manager
  departmentId   String?
  specialization String?
  licenseNumber  String?

  // System
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  preferences     String? // JSON string for UI preferences
  defaultCalendar String    @default("ethiopian") // 'ethiopian' or 'gregorian'
  
  // Invitation System
  invitationToken     String?   @unique
  invitationExpiresAt DateTime?
  invitedById         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  organization               Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department                 Department?        @relation(fields: [departmentId], references: [id])
  appointmentsAsDoctor       Appointment[]      @relation("DoctorAppointments")
  consultations              Consultation[]     @relation("DoctorConsultations")
  preTriagesScreened         PreTriage[]        @relation("ScreenedBy")
  preTriagesRouted           PreTriage[]        @relation("RoutedBy")
  triageAssessments          TriageAssessment[] @relation("TriagedBy")
  prescriptions              Prescription[]     @relation("PrescribingDoctor")
  prescriptionsDispensed     Prescription[]     @relation("DispensingPharmacist")
  pharmacySales              PharmacySale[]     @relation("PharmacySalesBy")
  labOrdersRequested         LabOrder[]         @relation("LabOrdersRequested")
  labOrdersCollected         LabOrder[]         @relation("LabOrdersCollected")
  labResultsEntered          LabResult[]        @relation("LabResultsEntered")
  labResultsVerified         LabResult[]        @relation("LabResultsVerified")
  radiologyOrdersRequested   RadiologyOrder[]   @relation("RadiologyOrdersRequested")
  radiologyOrdersPerformed   RadiologyOrder[]   @relation("RadiologyOrdersPerformed")
  radiologyReports           RadiologyReport[]  @relation("RadiologyReports")
  invoicesCreated            Invoice[]          @relation("InvoicesCreated")
  invoicesCancelled          Invoice[]          @relation("InvoicesCancelled")
  paymentsProcessed          Payment[]          @relation("PaymentsProcessed")
  auditLogs                  AuditLog[]         @relation("AuditLogsByUser")
  notifications              Notification[]     @relation("UserNotifications")
  checkedInAppointments      Appointment[]      @relation("CheckedInBy")
  queueAssigned              QueueManagement[]  @relation("QueueAssignedTo")
  deathCertificatesCertified DeathCertificate[] @relation("CertifiedBy")
  deathCertificatesIssued    DeathCertificate[] @relation("IssuedBy")
  
  // User Management Relations
  invitedBy              User?             @relation("UserInvitations", fields: [invitedById], references: [id])
  invitedUsers           User[]            @relation("UserInvitations")
  userInvitations        UserInvitation[]  @relation("InvitationsSent")
  userActivities         UserActivity[]

  // Doctor Accountability
  commissionConfig       DoctorCommissionConfig? @relation("DoctorCommissionConfig")
  commissions            DoctorCommission[]      @relation("DoctorCommissions")
  commissionsSettled     DoctorCommission[]      @relation("CommissionsSettled")

  @@index([organizationId])
  @@index([role])
  @@index([isActive])
  @@index([invitationToken])
}

/// Department
model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?
  headId         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  wards        Ward[]

  @@index([organizationId])
}

/// Patient
model Patient {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  mrn        String  @unique // Medical Record Number
  externalId String?

  // Personal Information
  firstName   String
  middleName  String?
  lastName    String
  dateOfBirth DateTime
  gender      String // male, female, other
  bloodGroup  String? // A+, B+, O+, AB+, A-, B-, O-, AB-

  // Contact
  phonePrimary   String?
  phoneSecondary String?
  email          String?

  // Address (Ethiopian format)
  region             String?
  zone               String?
  woreda             String?
  kebele             String?
  houseNumber        String?
  addressDescription String?

  // Emergency Contact
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // Medical Information (JSON arrays as strings)
  allergies          String? // JSON array
  chronicConditions  String? // JSON array
  currentMedications String? // JSON array

  // Insurance
  hasInsurance             Boolean   @default(false)
  insuranceProvider        String?
  insuranceId              String?
  insuranceExpiryDate      DateTime?
  insuranceCoverageDetails String? // JSON

  // Additional
  photoUrl       String?
  maritalStatus  String?
  occupation     String?
  educationLevel String?

  // System
  isActive Boolean @default(true)
  isVip    Boolean @default(false)
  notes    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  // Relations
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  consultations       Consultation[]
  preTriages          PreTriage[]
  queues              QueueManagement[]
  triageAssessments   TriageAssessment[]
  prescriptions       Prescription[]
  pharmacySales       PharmacySale[]
  labOrders           LabOrder[]
  radiologyOrders     RadiologyOrder[]
  invoices            Invoice[]
  payments            Payment[]
  admissions          Admission[]
  deathCertificates   DeathCertificate[]
  machineResultsQueue MachineResultsQueue[]

  @@index([organizationId])
  @@index([mrn])
  @@index([lastName, firstName])
  @@index([phonePrimary])
}

/// Pre-Triage (Ethiopian workflow - screening before main triage)
model PreTriage {
  id             String @id @default(cuid())
  organizationId String

  // Screening Information
  screeningNumber String @unique

  // Basic Demographics
  firstName String?
  lastName  String?
  age       Int?
  gender    String?
  phone     String?

  // Screening Assessment
  chiefComplaint String?
  briefHistory   String?

  // Vital Signs
  temperature            Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulseRate              Int?
  respiratoryRate        Int?    // breaths per minute
  spo2                   Float?  // oxygen saturation %
  weight                 Float?  // kg
  height                 Float?  // cm
  bmi                    Float?  // auto-calculated from weight/height
  fbs                    Float?  // fasting blood sugar mg/dL
  ppbs                   Float?  // post-prandial blood sugar mg/dL

  // Triage Routing Decision
  routedTo String? // adult_triage, mch_triage, psychiatric_triage

  // Status
  status String @default("screening") // screening, routed, registered_as_patient

  // If patient is registered after screening
  patientId String?

  screenedAt   DateTime  @default(now())
  screenedById String?
  routedAt     DateTime?
  routedById   String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id])
  screenedBy   User?        @relation("ScreenedBy", fields: [screenedById], references: [id])
  routedBy     User?        @relation("RoutedBy", fields: [routedById], references: [id])

  @@index([organizationId])
  @@index([screeningNumber])
  @@index([status])
}

/// Queue Management (Ethiopian unified queue system)
model QueueManagement {
  id             String @id @default(cuid())
  organizationId String

  // Patient & Service
  patientId   String?
  serviceArea String // opd, emergency, mch, psychiatric, etc.
  serviceType String? // consultation, procedure, etc.

  // Queue Information
  queueNumber String
  priority    String @default("normal") // urgent, normal, low

  // Assignment
  assignedToId String?
  assignedRoom String?

  // Status
  status String @default("waiting") // waiting, called, in_service, completed, cancelled, no_show

  // Timestamps
  joinedQueueAt      DateTime  @default(now())
  calledAt           DateTime?
  serviceStartedAt   DateTime?
  serviceCompletedAt DateTime?

  // Wait Time
  estimatedWaitMinutes Int?

  // Digital Display
  displayMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id])
  assignedTo   User?        @relation("QueueAssignedTo", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([serviceArea, status])
  @@index([assignedToId])
}

/// Triage Assessment (Ethiopian multi-type triage)
model TriageAssessment {
  id             String @id @default(cuid())
  organizationId String

  // Patient
  patientId     String
  appointmentId String?

  // Triage Type
  triageType String // emergency, pediatric, central, mch, psychiatric

  // Ethiopian ETAT for Pediatrics
  etatPriority String? // emergency, priority, queue
  etatCategory String? // respiratory, diarrhea, fever, malnutrition, etc.

  // Emergency Color Code
  urgencyLevel String? // red, yellow, green, black

  // Chief Complaint
  chiefComplaint String?

  // Vital Signs
  temperature            Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulseRate              Int?
  respiratoryRate        Int?
  oxygenSaturation       Int?
  weight                 Float?
  height                 Float?

  // Pediatric Specific (ETAT)
  ageMonths            Int?
  muac                 Float? // mid-upper arm circumference
  edema                Boolean @default(false)
  unableToDrink        Boolean @default(false)
  vomitingEverything   Boolean @default(false)
  convulsions          Boolean @default(false)
  lethargicUnconscious Boolean @default(false)

  // MCH Specific
  pregnancyWeeks      Int?
  gravida             Int?
  para                Int?
  lastMenstrualPeriod DateTime?

  // Psychiatric Specific
  mentalStatus     String?
  suicidalIdeation Boolean @default(false)
  violentBehavior  Boolean @default(false)
  substanceUse     Boolean @default(false)

  // Assessment & Plan
  triageNotes        String?
  triageCategory     String?
  recommendedService String?

  triagedById String?
  triagedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  triagedBy    User?        @relation("TriagedBy", fields: [triagedById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([triageType])
  @@index([urgencyLevel])
}

/// Appointment
model Appointment {
  id             String @id @default(cuid())
  organizationId String

  // Relations
  patientId String
  doctorId  String?

  // Appointment Details
  appointmentDate DateTime
  appointmentTime String
  durationMinutes Int      @default(30)
  appointmentType String? // new_patient, follow_up, emergency
  departmentId    String?
  priority        String  @default("normal") // normal, urgent

  // Status
  status String @default("scheduled") // scheduled, confirmed, checked_in, in_progress, completed, cancelled, no_show, rescheduled

  // Clinical
  chiefComplaint    String?
  notes             String?
  consultationNotes String?

  // Check-in/Check-out
  checkedInAt   DateTime?
  checkedInById String?
  startedAt     DateTime?
  completedAt   DateTime?

  // Cancellation
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  // Rescheduling (IDs only, no relations to avoid circular dependency)
  rescheduledFromId String?
  rescheduledToId   String?

  // Reminders
  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User?          @relation("DoctorAppointments", fields: [doctorId], references: [id])
  checkedInBy   User?          @relation("CheckedInBy", fields: [checkedInById], references: [id])
  consultations Consultation[]

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate, appointmentTime])
  @@index([status])
}

/// Consultation (Visit Record)
model Consultation {
  id             String @id @default(cuid())
  organizationId String

  // Relations
  patientId     String
  appointmentId String?
  doctorId      String

  // Visit Info
  visitDate DateTime @default(now())
  visitType String? // outpatient, emergency, follow_up

  // Vitals
  temperature            Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulseRate              Int?
  respiratoryRate        Int?
  weight                 Float?
  height                 Float?
  oxygenSaturation       Int?

  // Clinical Notes
  chiefComplaint          String?
  historyOfPresentIllness String?
  physicalExamination     String?
  diagnosis               String?
  icd10Codes              String? // JSON array

  // Treatment Plan
  treatmentPlan        String?
  followUpInstructions String?
  followUpDate         DateTime?

  // Referrals
  referredTo     String?
  referralReason String?

  // Additional
  notes       String?
  attachments String? // JSON array of file URLs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id])
  doctor          User             @relation("DoctorConsultations", fields: [doctorId], references: [id])
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  invoices        Invoice[]

  @@index([organizationId])
  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
}

// ============================================
// INPATIENT MODULE
// ============================================

/// Ward
model Ward {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  code           String?
  type           String? // general, icu, nicu, pediatric, maternity
  capacity       Int      @default(0)
  floor          String?
  chargeNurse    String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id])
  beds         Bed[]

  @@index([organizationId])
}

/// Bed
model Bed {
  id               String   @id @default(cuid())
  organizationId   String
  wardId           String
  bedNumber        String
  type             String? // standard, icu, special
  status           String   @default("available") // available, occupied, maintenance
  currentPatientId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ward         Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions   Admission[]

  @@index([organizationId])
  @@index([wardId])
  @@index([status])
}

/// Admission
model Admission {
  id             String  @id @default(cuid())
  organizationId String
  patientId      String
  bedId          String?

  admissionDate        DateTime @default(now())
  admissionType        String? // emergency, elective, transfer
  admissionReason      String?
  admissionDiagnosis   String?
  chiefComplaint       String?
  expectedLengthOfStay Int?
  depositAmount        Float?
  admissionNotes       String?
  isCritical           Boolean  @default(false)
  admittingDoctorId    String?
  attendingDoctorId    String?

  // Status
  status String @default("admitted") // admitted, discharged, transferred

  // Discharge
  dischargeDate          DateTime?
  dischargeReason        String?
  dischargeDiagnosis     String?
  dischargeSummary       String?
  treatmentSummary       String?
  dischargeCondition     String?
  medicationsOnDischarge String?
  dischargeNotes         String?
  followUpInstructions   String?
  dischargeDoctorId      String?

  // Follow-up
  followUpDate  DateTime?
  followUpNotes String?

  // Clinical notes (JSON: [{id, date, noteType, note, authorName, vitals?}])
  clinicalNotes String?

  // IPD billing snapshot
  dailyRoomRate     Float?
  totalBillAmount   Float?
  billGenerated     Boolean @default(false)
  additionalCharges String? // JSON: [{id, name, type, amount, quantity, date}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id])
  bed          Bed?         @relation(fields: [bedId], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([status])
}

/// Death Certificate (Ethiopian standard)
model DeathCertificate {
  id                String @id @default(cuid())
  organizationId    String
  patientId         String
  certificateNumber String @unique // DC-YYYY-XXXX

  // Death Details
  dateOfDeath     DateTime
  timeOfDeath     String? // HH:mm
  placeOfDeath    String // inpatient, emergency, doa, home, other
  locationDetails String?

  // Deceased Demographics (Snapshotted from patient at time of death)
  ageAtDeathYears  Int?
  ageAtDeathMonths Int?
  ageAtDeathDays   Int?
  sex              String
  maritalStatus    String?
  occupation       String?
  address          String?

  // Cause of Death (Ethiopian Format)
  // Part I: Chain of events
  immediateCause   String // (a)
  antecedentCauseB String? // (b)
  antecedentCauseC String? // (c)
  antecedentCauseD String? // (d)

  // Part II: Other significant conditions
  otherConditions String?

  mannerOfDeath String // natural, accident, suicide, homicide, pending, undetermined

  // Autopsy
  autopsyPerformed Boolean @default(false)
  autopsyFindings  String?

  // Maternal Death (If applicable)
  isMaternalDeath  Boolean @default(false)
  pregnancyRelated String? // pregnant, within_42_days, within_1_year, not_related

  // Certification
  certifiedById          String
  certificationDate      DateTime @default(now())
  certifierQualification String? // MD, Nurse, etc.
  licenseNumber          String?
  signatureUrl           String?

  // Issuance Tracking
  issuedTo             String?
  issuedToRelationship String?
  issuedToNationalId   String?
  issuedAt             DateTime?
  issuedById           String?

  // System
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  certifiedBy  User         @relation("CertifiedBy", fields: [certifiedById], references: [id])
  issuedBy     User?        @relation("IssuedBy", fields: [issuedById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([certificateNumber])
}

// ============================================
// PHARMACY MODULE
// ============================================

/// Pharmacy Drug (Drug Catalog/Inventory)
model PharmacyDrug {
  id             String @id @default(cuid())
  organizationId String

  // Drug Information
  drugName     String
  genericName  String?
  brandName    String?
  drugCode     String?
  drugCategory String? // antibiotic, analgesic, etc.
  dosageForm   String? // tablet, capsule, syrup, injection
  strength     String? // 500mg, 10mg/ml, etc.

  // Inventory
  quantityInStock   Int     @default(0)
  unitOfMeasure     String? // tablet, bottle, vial, box
  reorderLevel      Int     @default(10)
  maximumStockLevel Int?

  // Pricing
  costPrice        Float?
  sellingPrice     Float?
  markupPercentage Float?

  // Storage
  storageLocation      String?
  requiresPrescription Boolean @default(false)

  // Supplier
  supplierName    String?
  supplierContact String?

  // Additional
  description       String?
  sideEffects       String?
  contraindications String?
  isActive          Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches       PharmacyBatch[]
  eaptsMappings EaptsMedicationMapping[]

  @@index([organizationId])
  @@index([drugName])
  @@index([drugCategory])
  @@index([quantityInStock])
}

/// Pharmacy Batch (Batch/Lot Tracking)
model PharmacyBatch {
  id             String @id @default(cuid())
  organizationId String
  drugId         String

  // Batch Info
  batchNumber     String
  manufactureDate DateTime?
  expiryDate      DateTime

  // Quantity
  quantityReceived  Int
  quantityRemaining Int

  // Purchase
  purchaseOrderNumber String?
  purchaseDate        DateTime?
  costPricePerUnit    Float?
  totalCost           Float?

  // Supplier
  supplierName    String?
  supplierInvoice String?

  // Status
  status String @default("active") // active, expired, recalled, depleted

  createdAt   DateTime @default(now())
  createdById String?

  drug PharmacyDrug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@index([drugId])
  @@index([expiryDate])
  @@index([status])
}

/// Prescription
model Prescription {
  id             String @id @default(cuid())
  organizationId String

  // Relations
  patientId      String
  consultationId String?
  doctorId       String

  // Prescription Details
  prescriptionDate DateTime @default(now())

  // Items (JSON array)
  items String // JSON: [{drugId, drugName, dosage, frequency, duration, quantity, instructions}]

  // Dispensing
  status        String    @default("pending") // pending, partially_dispensed, fully_dispensed, cancelled
  dispensedById String?
  dispensedAt   DateTime?

  // Additional
  notes            String?
  isRefill         Boolean @default(false)
  refillsAllowed   Int     @default(0)
  refillsRemaining Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation  Consultation?  @relation(fields: [consultationId], references: [id])
  doctor        User           @relation("PrescribingDoctor", fields: [doctorId], references: [id])
  dispensedBy   User?          @relation("DispensingPharmacist", fields: [dispensedById], references: [id])
  pharmacySales PharmacySale[]

  @@index([organizationId])
  @@index([patientId])
  @@index([status])
}

/// Pharmacy Sale
model PharmacySale {
  id             String @id @default(cuid())
  organizationId String

  // Relations
  patientId      String?
  prescriptionId String?
  servedById     String?

  // Sale Details
  saleDate DateTime @default(now())
  saleType String? // prescription, otc

  // Items (JSON array)
  items String // JSON: [{drugId, batchId, drugName, quantity, unitPrice, total}]

  // Financial
  subtotal       Float
  discountAmount Float @default(0)
  taxAmount      Float @default(0)
  totalAmount    Float

  // Payment
  paymentStatus String  @default("pending") // pending, paid, partially_paid
  paymentMethod String?
  amountPaid    Float   @default(0)
  amountDue     Float?

  // Receipt
  receiptNumber String @unique

  createdAt   DateTime @default(now())
  createdById String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  servedBy     User?         @relation("PharmacySalesBy", fields: [servedById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([saleDate])
}

/// Pharmacy Purchase Order
model PharmacyPurchaseOrder {
  id             String @id @default(cuid())
  organizationId String

  poNumber String // e.g. PO-2026-0001
  status   String @default("draft") // draft | submitted | approved | received | cancelled

  // Supplier
  supplierName    String
  supplierContact String?
  supplierEmail   String?

  // Dates
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?

  // Items (JSON): [{drugId, drugName, strength, quantityOrdered, quantityReceived, unitCost, totalCost, batchNumber, expiryDate}]
  items       String
  totalAmount Float  @default(0)

  notes            String?
  cancellationNote String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([orderDate])
}

// ============================================
// LABORATORY MODULE
// ============================================

/// Lab Test (Test Catalog)
model LabTest {
  id             String @id @default(cuid())
  organizationId String

  // Test Information
  testName     String
  testCode     String?
  testCategory String? // hematology, chemistry, microbiology, serology
  testType     String? // quantitative, qualitative

  // Specimen
  specimenType      String? // blood, urine, stool, sputum
  specimenVolume    String?
  specimenContainer String?

  // Results
  resultType String? // numeric, text, positive_negative, select
  unit       String?

  // Reference Ranges (JSON)
  referenceRanges String? // JSON: {male: {min, max}, female: {min, max}}

  // Pricing
  price Float?

  // Processing
  turnaroundTime Int? // in hours
  department     String?

  // Additional
  preparationInstructions String?
  clinicalSignificance    String?
  isActive                Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  labResults   LabResult[]

  @@index([organizationId])
  @@index([testCategory])
}

/// Lab Order
model LabOrder {
  id             String @id @default(cuid())
  organizationId String

  // Relations
  patientId      String
  consultationId String?
  requestedById  String

  // Order Details
  orderDate   DateTime @default(now())
  orderNumber String   @unique

  // Tests ordered (JSON array)
  tests String // JSON: [{testId, testName, testCode, urgency}]

  // Clinical Info
  clinicalIndication   String?
  provisionalDiagnosis String?

  // Priority
  priority String @default("routine") // routine, urgent, stat

  // Status
  status String @default("pending") // pending, sample_collected, in_progress, completed, cancelled

  // Sample Collection
  sampleCollectedAt   DateTime?
  sampleCollectedById String?
  accessionNumber     String?   @unique // barcode for sample

  // Results
  resultsEnteredAt    DateTime?
  resultsEnteredById  String?
  resultsVerifiedAt   DateTime?
  resultsVerifiedById String?
  resultsReportedAt   DateTime?

  // Additional
  notes           String?
  rejectionReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  requestedBy       User          @relation("LabOrdersRequested", fields: [requestedById], references: [id])
  sampleCollectedBy User?         @relation("LabOrdersCollected", fields: [sampleCollectedById], references: [id])
  results           LabResult[]

  @@index([organizationId])
  @@index([patientId])
  @@index([status])
  @@index([accessionNumber])
}

/// Lab Result
model LabResult {
  id             String  @id @default(cuid())
  organizationId String?

  // Relations
  orderId String
  testId  String

  // Result
  resultValue String
  resultUnit  String?

  // Interpretation
  isAbnormal Boolean @default(false)
  isCritical Boolean @default(false)
  flag       String? // H (high), L (low), N (normal), A (abnormal)

  // Reference Range
  referenceRangeMin  Float?
  referenceRangeMax  Float?
  referenceRangeText String?

  // Quality Control
  qcLevel  String?
  qcPassed Boolean?

  // Method/Instrument
  methodUsed     String?
  instrumentUsed String?

  // Personnel
  enteredById  String?
  enteredAt    DateTime  @default(now())
  verifiedById String?
  verifiedAt   DateTime?

  // Comments
  comment         String?
  technicianNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test       LabTest  @relation(fields: [testId], references: [id])
  enteredBy  User?    @relation("LabResultsEntered", fields: [enteredById], references: [id])
  verifiedBy User?    @relation("LabResultsVerified", fields: [verifiedById], references: [id])

  @@index([orderId])
  @@index([isCritical])
}

