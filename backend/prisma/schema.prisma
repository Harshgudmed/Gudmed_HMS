/// Radiology Order
model RadiologyOrder {
  id             String @id @default(cuid())
  organizationId String

  // Relations
  patientId      String
  consultationId String?
  requestedById  String
  examId         String

  // Order Details
  orderDate   DateTime @default(now())
  orderNumber String   @unique

  // Clinical Information
  clinicalIndication   String?
  provisionalDiagnosis String?
  relevantHistory      String?

  // Priority
  urgency String @default("routine") // routine, urgent, stat

  // Status
  status String @default("pending") // pending, scheduled, in_progress, completed, reported, cancelled

  // Scheduling
  scheduledDate DateTime?

  // Examination
  examPerformedAt DateTime?
  performedById   String?

  // Reporting
  reportCreatedAt  DateTime?
  reportedById     String?
  reportVerifiedAt DateTime?
  verifiedById     String?

  // Additional
