  taxPercentage Float   @default(0)

  // Insurance
  isCoveredByInsurance     Boolean @default(true)
  insuranceCopayPercentage Float?

  // Additional
  description String?
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
