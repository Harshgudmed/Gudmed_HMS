/// Radiology Exam (Exam Catalog)
model RadiologyExam {
  id             String @id @default(cuid())
  organizationId String

  // Exam Information
  examName     String
  examCode     String?
  examCategory String? // x-ray, ct, mri, ultrasound, mammography
  bodyPart     String?

