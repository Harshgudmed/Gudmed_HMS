# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
ORGANIZATION_ID=org-demo



# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://gudmed.vercel.app

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Provider: wame (default, wa.me links — no cost) | twilio | wati | meta

# wa.me mode (default — no API key needed)
WHATSAPP_PROVIDER=wame
WHATSAPP_COUNTRY_CODE=91

# Twilio mode (free tier available at twilio.com)
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_WHATSAPP_FROM=+14155238886

# WATI mode (wati.io)
# WHATSAPP_PROVIDER=wati
# WHATSAPP_API_KEY=xxxx
# WHATSAPP_API_URL=https://api.wati.io

# Meta Cloud API mode
# WHATSAPP_PROVIDER=meta
# WHATSAPP_API_KEY=xxxx
# META_PHONE_NUMBER_ID=1234567890

# Pharmacy team WhatsApp number (for internal notifications)
# WHATSAPP_PHARMACY_TEAM_PHONE=9876543210

# Webhook verification token
WHATSAPP_VERIFY_TOKEN=gudmed_verify
